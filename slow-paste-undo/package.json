{
  "name": "slow-paste-undo",
  "displayName": "Slow Paste Undo",
  "description": "Animate undoing the most recent paste one character at a time.",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "slowPasteUndo.undo",
        "title": "Undo (Animate Recent Paste)"
      },
      {
        "command": "slowPasteUndo.paste",
        "title": "Paste (Track for Animated Undo)"
      }
    ],
    "keybindings": [
      {
        "key": "ctrl+z",
        "mac": "cmd+z",
        "command": "slowPasteUndo.undo",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "key": "ctrl+v",
        "mac": "cmd+v",
        "command": "slowPasteUndo.paste",
        "when": "editorTextFocus && !editorReadonly"
      }
    ],
    "configuration": {
      "title": "Slow Paste Undo",
      "properties": {
        "slowPasteUndo.characterDelay": {
          "type": "integer",
          "default": 35,
          "minimum": 0,
          "maximum": 1000,
          "description": "Delay in milliseconds between each character disappearing during paste undo."
        }
      }
    }
  }
}
